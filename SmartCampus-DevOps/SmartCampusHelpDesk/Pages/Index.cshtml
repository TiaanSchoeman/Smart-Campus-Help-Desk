@page
@model IndexModel
@{
    ViewData["Title"] = "Help Desk";
}

<div class="text-center mb-4">
    <h1 class="display-5">Smart Campus Help Desk</h1>
    <p class="lead">Report campus technical problems and track submitted requests. Campus capture form for Version 1.0.</p>
</div>

@if (Model.EnhancedUi)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h5 class="card-title">Campus coverage</h5>
                    <p class="card-text mb-0">Network, computer labs, licensed software and student accounts.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h5 class="card-title">Support hours</h5>
                    <p class="card-text mb-0">Monday to Friday 07:30 – 16:30. After-hours issues stay queued as Open.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h5 class="card-title">Logged requests</h5>
                    <p class="card-text mb-0">@Model.Issues.Count request(s) currently listed.</p>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-5">
        <h2>Log a new issue</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NewIssue.StudentName" class="form-label"></label>
                <input asp-for="NewIssue.StudentName" class="form-control" />
                <span asp-validation-for="NewIssue.StudentName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewIssue.Category" class="form-label"></label>
                <select asp-for="NewIssue.Category" class="form-select" asp-items="@(new SelectList(Model.Categories))">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="NewIssue.Category" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewIssue.Description" class="form-label"></label>
                <textarea asp-for="NewIssue.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="NewIssue.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewIssue.Status" class="form-label"></label>
                <select asp-for="NewIssue.Status" class="form-select" asp-items="@(new SelectList(Model.Statuses))"></select>
            </div>

            <button type="submit" class="btn btn-primary">Submit Issue</button>
        </form>
    </div>
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="mb-0">Submitted issues</h2>
        </div>

        @if (Model.EnhancedUi)
        {
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input name="Search" value="@Model.Search" class="form-control" placeholder="Search name, category or status" />
                    <button class="btn btn-outline-secondary" type="submit">Search</button>
                </div>
            </form>
        }

        @if (!Model.Issues.Any())
        {
            <p>No issues have been submitted yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Student</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var issue in Model.Issues)
                        {
                            <tr>
                                <td>@issue.Id</td>
                                <td>@issue.StudentName</td>
                                <td>@issue.Category</td>
                                <td>@issue.Description</td>
                                <td>@issue.Status</td>
                                <td>@issue.Date.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
