@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartCampusHelpDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartCampusHelpDesk.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // Version/Environment are read from configuration (appsettings.json /
        // environment variables) at request time, NOT hardcoded here. This is
        // what keeps the banner "swappable" across the Blue/Green App Service
        // slots: these values must be plain (non slot-sticky) app settings so
        // they travel with a slot swap instead of staying pinned to the slot.
        var appVersion = Configuration["AppInfo:Version"] ?? "1.0";
        var appEnvironment = Configuration["AppInfo:Environment"] ?? "BLUE";
        var envClass = appEnvironment.Equals("GREEN", StringComparison.OrdinalIgnoreCase) ? "env-green" : "env-blue";
    }
    <div id="deployment-banner" class="env-banner @envClass" data-app-version="@appVersion" data-app-environment="@appEnvironment">
        Application Version: @appVersion | Environment: @appEnvironment
    </div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">SmartCampusHelpDesk</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SmartCampusHelpDesk - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>