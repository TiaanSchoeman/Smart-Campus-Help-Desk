@page
@model IndexModel
@{
    ViewData["Title"] = "Help Desk";
}

<div class="text-center mb-4">
    <h1 class="display-5">Smart Campus Help Desk</h1>
    <p>Log a new issue below and view all submitted issues in the table.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <h2>Log a New Issue</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="NewIssue.StudentName"></label>
                <input asp-for="NewIssue.StudentName" class="form-control" />
                <span asp-validation-for="NewIssue.StudentName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewIssue.Category"></label>
                <select asp-for="NewIssue.Category" class="form-select" asp-items="@(new SelectList(Model.Categories))">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="NewIssue.Category" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewIssue.Description"></label>
                <textarea asp-for="NewIssue.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="NewIssue.Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewIssue.Status"></label>
                <select asp-for="NewIssue.Status" class="form-select" asp-items="@(new SelectList(Model.Statuses))"></select>
                <span asp-validation-for="NewIssue.Status" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit Issue</button>
        </form>
    </div>
</div>

<hr />

<h2>Submitted Issues</h2>
@if (!Model.Issues.Any())
{
    <p>No issues have been submitted yet.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Student</th>
                <th>Category</th>
                <th>Description</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var issue in Model.Issues)
            {
                <tr>
                    <td>@issue.Id</td>
                    <td>@issue.StudentName</td>
                    <td>@issue.Category</td>
                    <td>@issue.Description</td>
                    <td>@issue.Status</td>
                    <td>@issue.Date.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
